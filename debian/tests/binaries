#!/usr/bin/ruby

exceptions=%w[
  bundle
  bundler
  racc
]

version = RbConfig::CONFIG["RUBY_API_VERSION"]
binaries = Dir["/usr/bin/*#{version}"]
missing = 0
binaries.each do |binary|
  link = binary.sub(version, "")
  next if exceptions.include?(File.basename(link))
  missing += 1 unless system("ls", "-l", link)
end

exit(1) if missing > 0
